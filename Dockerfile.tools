FROM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS nuclei
ARG CERBERUS_NUCLEI_COMMIT=a8c88feb4a1c8e961b7902534ce3af97e9d524a4
RUN apk add --no-cache git \
    && git clone --filter=blob:none https://github.com/projectdiscovery/nuclei.git /src/nuclei \
    && git -C /src/nuclei checkout "${CERBERUS_NUCLEI_COMMIT}" \
    && cd /src/nuclei \
    && go get github.com/go-git/go-git/v5@v5.19.2 \
        golang.org/x/crypto@v0.55.0 \
        golang.org/x/mod@v0.40.0 \
        google.golang.org/grpc@v1.83.2 \
    && go mod tidy \
    && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /usr/local/bin/nuclei ./cmd/nuclei \
    && /usr/local/bin/nuclei -version

FROM alpine/git:2.49.1@sha256:c0280cf9572316299b08544065d3bf35db65043d5e3963982ec50647d2746e26 AS sqlmap
ARG CERBERUS_SQLMAP_COMMIT=3cfba468d79ab0a88c9d6c79e572cabdfd77d219
RUN git clone --filter=blob:none https://github.com/sqlmapproject/sqlmap.git /src/sqlmap \
    && git -C /src/sqlmap checkout "${CERBERUS_SQLMAP_COMMIT}" \
    && rm -rf /src/sqlmap/.git

FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
ARG CERBERUS_LIGHTHOUSE_VERSION=13.5.0
ARG CERBERUS_VERSION=0.2.0
ARG CERBERUS_REVISION=unknown
ARG CERBERUS_CREATED=unknown

LABEL org.opencontainers.image.title="Cerberus scanner tools" \
      org.opencontainers.image.description="Isolated Lighthouse, Nuclei, and sqlmap worker for Cerberus" \
      org.opencontainers.image.source="https://github.com/vaxman14/cerberus-selfhost" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.version="${CERBERUS_VERSION}" \
      org.opencontainers.image.revision="${CERBERUS_REVISION}" \
      org.opencontainers.image.created="${CERBERUS_CREATED}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium python3 \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g --ignore-scripts "lighthouse@${CERBERUS_LIGHTHOUSE_VERSION}" \
    && rm -rf /usr/local/lib/node_modules/npm \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
    && groupadd --system --gid 10001 cerberus-tools \
    && useradd --system --uid 10001 --gid cerberus-tools --home-dir /tmp cerberus-tools

COPY --from=nuclei /usr/local/bin/nuclei /usr/local/bin/nuclei
COPY --from=sqlmap /src/sqlmap /opt/sqlmap
RUN HOME=/root nuclei -update-templates -ud /opt/nuclei-templates \
    && chmod -R a=rX /opt/nuclei-templates /opt/sqlmap

WORKDIR /app
COPY cerberus/tools_api.py ./cerberus/tools_api.py
COPY cerberus/__init__.py ./cerberus/__init__.py

USER cerberus-tools
EXPOSE 8181
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8181/health', timeout=3).read()"]
CMD ["python3", "-m", "cerberus.tools_api"]
