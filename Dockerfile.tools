FROM projectdiscovery/nuclei:v3.11.1@sha256:582d5546902e67052097cb2d07296c642d50a1afc5e44623cb038845df9a32eb AS nuclei

FROM alpine/git:2.49.1 AS sqlmap
ARG CERBERUS_SQLMAP_COMMIT=3cfba468d79ab0a88c9d6c79e572cabdfd77d219
RUN git clone --filter=blob:none https://github.com/sqlmapproject/sqlmap.git /src/sqlmap \
    && git -C /src/sqlmap checkout "${CERBERUS_SQLMAP_COMMIT}" \
    && rm -rf /src/sqlmap/.git

FROM node:22-bookworm-slim
ARG CERBERUS_LIGHTHOUSE_VERSION=13.5.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium python3 \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g --ignore-scripts "lighthouse@${CERBERUS_LIGHTHOUSE_VERSION}" \
    && groupadd --system --gid 10001 cerberus-tools \
    && useradd --system --uid 10001 --gid cerberus-tools --home-dir /tmp cerberus-tools

COPY --from=nuclei /usr/local/bin/nuclei /usr/local/bin/nuclei
COPY --from=sqlmap /src/sqlmap /opt/sqlmap
RUN HOME=/root nuclei -update-templates -ud /opt/nuclei-templates \
    && chmod -R a=rX /opt/nuclei-templates /opt/sqlmap

WORKDIR /app
COPY cerberus/tools_api.py ./cerberus/tools_api.py
COPY cerberus/__init__.py ./cerberus/__init__.py

USER cerberus-tools
EXPOSE 8181
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8181/health', timeout=3).read()"]
CMD ["python3", "-m", "cerberus.tools_api"]
