# Required. Generate with: openssl rand -hex 32
CERBERUS_API_KEY=replace-with-a-long-random-value

# Localhost is safest. Use 0.0.0.0 only behind a firewall/reverse proxy.
CERBERUS_BIND=127.0.0.1
CERBERUS_PORT=8099

# Optional. Raises Google PageSpeed API quota for the performance head.
PAGESPEED_API_KEY=
