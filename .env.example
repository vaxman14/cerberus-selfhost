# Localhost is safest. Use a private interface only behind a firewall or HTTPS proxy.
CERBERUS_BIND=127.0.0.1
CERBERUS_PORT=8099

# Immutable release images. Change only when deliberately upgrading.
CERBERUS_IMAGE=romanvaxman/cerberus-selfhost:0.2.1
CERBERUS_TOOLS_IMAGE=romanvaxman/cerberus-tools:0.2.1
CERBERUS_ZAP_IMAGE=romanvaxman/cerberus-zap:0.2.1

# Named volumes. Restore switches CERBERUS_DATA_VOLUME to a proven generation.
CERBERUS_DATA_VOLUME=cerberus-data
CERBERUS_CODEX_VOLUME=cerberus-codex
CERBERUS_MASTER_KEY_VOLUME=cerberus-master-key

# Optional API key for scripts. The browser uses a local username/password session.
# Generate with: openssl rand -hex 32
CERBERUS_API_KEY=

# Active Nuclei/ZAP/sqlmap checks still require explicit per-scan confirmation.
CERBERUS_ENABLE_ACTIVE_SCANS=false

# Optional non-interactive first-owner bootstrap. The password stays in a file.
# CERBERUS_BOOTSTRAP_USERNAME=admin
# CERBERUS_BOOTSTRAP_PASSWORD_FILE=/run/cerberus-secrets/bootstrap_password
