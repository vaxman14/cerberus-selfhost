# Required. Generate with: openssl rand -hex 32
CERBERUS_API_KEY=replace-with-a-long-random-value

# Localhost is safest. Use 0.0.0.0 only behind a firewall/reverse proxy.
CERBERUS_BIND=127.0.0.1
CERBERUS_PORT=8099

# Optional. Raises Google PageSpeed API quota for the performance head.
PAGESPEED_API_KEY=

# Optional Cerberus AI Lab (compose.ai-lab.yaml). Generate a separate password:
# openssl rand -hex 24
CERBERUS_AI_USERNAME=admin
CERBERUS_AI_PASSWORD=
CERBERUS_AI_PORT=9137

# Generate once, back it up separately, never commit it, then initialize the
# external Docker vault volume with scripts/init-vault.sh:
# mkdir -p secrets && openssl rand -base64 32 > secrets/cerberus_master_key
# chmod 600 secrets/cerberus_master_key
CERBERUS_MASTER_KEY_VOLUME=cerberus-master-key

# Conservative defaults for autonomous lab traffic.
CERBERUS_AI_RATE_RPS=5
CERBERUS_AI_RATE_BURST=10
